# ===== Supabase (a service_role fica SO aqui, no servidor do worker) =====
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Project Settings > API Keys > Secret key (sb_secret_...) ou, em projeto antigo, a service_role legada
SUPABASE_SERVICE_ROLE_KEY=

# ===== IA =====
ANTHROPIC_API_KEY=
AUDIT_MODEL=claude-sonnet-5-5
# Transcricao de audios e ligacoes (Whisper da OpenAI ou outro servico compativel)
TRANSCRIBE_API_KEY=
TRANSCRIBE_URL=https://api.openai.com/v1/audio/transcriptions
TRANSCRIBE_MODEL=whisper-1

# ===== Rotina =====
TZ=America/Sao_Paulo
AUDIT_IDLE_MINUTES=20
AUDIT_EVERY_MINUTES=5
DAYS_BACK=1
# Se quiser auditar so alguns numeros (DDI+DDD+numero, separados por virgula). Vazio = todos os chats individuais
LEAD_ALLOWLIST=
PORT=8080

# ===== Espelho no Google Sheets (opcional, mantem o dash antigo funcionando) =====
SHEET_ID=1hg2lFrFegLFkDinkt-58DC52vVHUnir3Ql217tDFCWM
GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/service-account.json
SHEET_TAB=SDR
AUDIT_TAB=Auditoria
MESSAGES_TAB=Mensagens
# false = a planilha recebe so numeros e auditorias, sem o texto das mensagens
SHEET_MESSAGES=true
