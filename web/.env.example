# ===== PUBLICAS (podem ir para o navegador) =====
# Supabase > botao Connect (topo do painel) ou Project Settings > Data API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Supabase > Project Settings > API Keys > Publishable key (sb_publishable_...)
# Projeto antigo: aba Legacy API Keys > anon. As duas funcionam
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ===== SECRETA (SO SERVIDOR) =====
# Supabase > Project Settings > API Keys > Secret key (sb_secret_...)
# Projeto antigo: aba Legacy API Keys > service_role. As duas funcionam
# NUNCA coloque NEXT_PUBLIC_ nesta variavel. Ela so e usada em src/lib/supabase/admin.ts (acoes de admin)
SUPABASE_SERVICE_ROLE_KEY=

# URL do site (usada nos e-mails de recuperacao de senha)
NEXT_PUBLIC_SITE_URL=https://auditoria-comercial-omega.vercel.app
